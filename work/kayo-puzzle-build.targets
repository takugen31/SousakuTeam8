<Project>
  <!-- Include the new script even before Unity regenerates its IDE project. -->
  <Target Name="IncludeKayoPuzzleBridge" BeforeTargets="CoreCompile" Condition="'$(AssemblyName)' == 'Assembly-CSharp'">
    <ItemGroup>
      <_ExistingChoiceHover Include="@(Compile)" Condition="'%(Compile.Filename)' == 'ChoiceButtonHoverScale'" />
      <Compile Include="$(MSBuildProjectDirectory)\Assets\Scripts\Dialogue\Runtime\ChoiceButtonHoverScale.cs"
               Condition="'@(_ExistingChoiceHover)' == ''" />
      <_ExistingDialogueFeather Include="@(Compile)" Condition="'%(Compile.Filename)' == 'DialogueWindowFeather'" />
      <Compile Include="$(MSBuildProjectDirectory)\Assets\Scripts\Dialogue\Runtime\DialogueWindowFeather.cs"
               Condition="'@(_ExistingDialogueFeather)' == ''" />
      <_YowashiExistingCatch Include="@(Compile)" Condition="'%(Compile.Filename)' == 'YowashiCatchGameFlowController'" />
      <Compile Include="$(MSBuildProjectDirectory)\Assets\FallingGame\Scripts\YowashiCatchGameFlowController.cs"
               Condition="'@(_YowashiExistingCatch)' == ''" />
      <_KayoExistingBridge Include="@(Compile)" Condition="'%(Compile.Filename)' == 'KayoPuzzleGameFlowController'" />
      <Compile Include="$(MSBuildProjectDirectory)\Assets\Scripts\Search\KayoPuzzleGameFlowController.cs"
               Condition="'@(_KayoExistingBridge)' == ''" />
      <_KayoExistingGauge Include="@(Compile)" Condition="'%(Compile.Filename)' == 'KayoGaugeOutcomeController'" />
      <_YowashiExistingPuzzle Include="@(Compile)" Condition="'%(Compile.Filename)' == 'YowashiPuzzleEntryController'" />
      <Compile Include="$(MSBuildProjectDirectory)\Assets\Scripts\Search\YowashiPuzzleEntryController.cs"
               Condition="'@(_YowashiExistingPuzzle)' == ''" />
      <Compile Include="$(MSBuildProjectDirectory)\Assets\Scripts\Search\KayoGaugeOutcomeController.cs"
               Condition="'@(_KayoExistingGauge)' == ''" />
    </ItemGroup>
  </Target>
</Project>
