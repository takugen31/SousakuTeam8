%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71853f32b16e4d059176459186bcd4b9, type: 3}
  m_Name: ArchiveDatabase
  m_EditorClassIdentifier: Assembly-CSharp::ArchiveDatabase
  uiFont: {fileID: 11400000, guid: 605d5d10cb9d13f45b4c5b4e27b115b4, type: 2}
  entries:
  - id: system.archive_guide
    category: 4
    title: アーカイブについて
    subtitle: 獲得した情報を、いつでも振り返ることができます。
    body: "人物・場所・手がかり・記録など、ゲーム中に獲得した情報がここへ追加されます。\n\n左側のカテゴリや検索欄を使うと、目的の情報を絞り込めます。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 0
    unlockedAtStart: 1
    showBeforeUnlock: 0
  - id: system.archive_controls
    category: 4
    title: 情報画面の操作
    subtitle: Bキーから情報タブを開きます。
    body: "Bキーでアーカイブを開閉します。\n\n上下キーで項目を選択し、マウスホイールで一覧や本文をスクロールできます。ESCキーでも画面を閉じられます。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 10
    unlockedAtStart: 1
    showBeforeUnlock: 0
  - id: chapter1.bookshelf
    category: 2
    title: 本棚
    subtitle: 白い部屋の左側に置かれた木製の本棚。
    body: "数多くの本が整然と並べられている。どの本も長い間、この部屋に置かれていたようだ。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 100
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter1.nameplate
    category: 2
    title: ドアの表札
    subtitle: ドアの上に取り付けられた横長の木製表札。
    body: "白いドアの上に、茶色い表札が掲げられている。部屋を調べるうえで重要な手がかりかもしれない。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 110
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter1.manga
    category: 2
    title: ベッドの上の漫画
    subtitle: 白いベッドの上に置かれていた漫画。
    body: "数冊の漫画が重ねて置かれている。誰かがここで読んでいたのだろうか。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 120
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter1.facing_wall
    category: 2
    title: ベッドが面している壁
    subtitle: ベッドの正面に広がる白い壁。
    body: "一見すると何もない白い壁だが、注意深く確認しておく必要がありそうだ。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 130
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_kayo.floor_dent
    category: 2
    title: 床のくぼみ
    subtitle: 白い部屋の床にできた小さなくぼみ。
    body: "何もないと思っていた床に、よく見ると小さなくぼみがある。誰かがここで何度もつまずいたのだろうか。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 200
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_kayo.bookshelf
    category: 1
    title: 本棚
    subtitle: 白い部屋に置かれた豪華な本棚。
    body: "伝説の漫画『ツンデレラのガラスの心』などが並ぶ豪華な本棚。調べていると、何かが落ちる音がした。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 210
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_kayo.paper_scrap
    category: 2
    title: 紙片
    subtitle: 本棚から落ちてきた破れた紙。
    body: "破れていて一部しか読めない。『わた……いで……しい』……他の紙片を集めれば、組み立てて読めるかもしれない。"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 220
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_yowashi.bandage
    category: 2
    title: ヨワシの腕の包帯
    subtitle:
    body: "これは我が腕に宿しベルゼバブを封じ込める封印……\n　絶対に中を見てはいけないよ、少年"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 300
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_yowashi.manga
    category: 2
    title: ヨワシの好きな漫画
    subtitle:
    body: "わかるわかる！しかしこの本棚に大量のラノベや漫画があることには気づいていたかい……？"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 310
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_yowashi.diary
    category: 3
    title: 誰かの日記
    subtitle:
    body: "『20XX年4月8日』\n今年も入学式に行けなかった。いくら私が体調は大丈夫だって言っても、ママは聞いてくれない。なんで私の言うことを信じてくれないんだろう。\n『20XX年5月12日』\n今年初めて学校に行けた。何回もママにおねだりした甲斐があったかも。とても嬉しかったのに、学校に行ってみたら咳が止まらなくなった。なんで？友達はすごく心配してくれたのに、私は、私は、私は\n『20XX年5月13日』\n私は今日から弱音を吐かないことにした。そのためには明るくいよう。だって漫画のキャラクターで弱音吐いてる子なんて誰もいない。あのキャラみたいになりたい。\n『20XX年6月6日』\n大丈夫、私は明るい子、強い子、大丈夫。\n『20XX年6月7日』\n大丈夫、私は明るい子、強い子、大丈夫。\n『20XX年9月11日』\n大丈夫、私は明るい子、強い子、大丈夫\n(これ以降、同じ言葉が時々書かれているだけだ)"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 320
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_yowashi.unknown_book
    category: 2
    title: 何かの本
    subtitle:
    body: "この……試練に……合格した……証として……この本を……やろう"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 330
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_yowashi.breathlessness
    category: 2
    title: ヨワシは息切れしやすい
    subtitle:
    body: "(おかしいな、キャッチボールって言っても2分くらいしかやってないと思うんだけど……あんなに息切れするもんかな？)"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 340
    unlockedAtStart: 0
    showBeforeUnlock: 0
  - id: chapter_yowashi.medical_knowledge
    category: 2
    title: 医学書の知識
    subtitle:
    body: "これは……僕もそこまでよく分からないけど、医学書じゃないかな？SpO2っていうのは聞いたことあるよ。確か……血管の中の酸素濃度じゃなかった？\nうん。このあたり、喘息について書いてあるよ。こんな本ドウテくんは持ってたんだね！やっぱり凄いよ！！"
    icon: {fileID: 0}
    acquisitionHint:
    sortOrder: 350
    unlockedAtStart: 0
    showBeforeUnlock: 0
