  lines:
  - lineId: prologue1_001
    speakerId: doute
    expressionId: normal
    text: "\u5C11\u3057\u304F\u3089\u3044\u307D\u3063\u3061\u3083\u308A\u3067\u3082\u5973\u306E\u5B50\u306F\u53EF\u611B\u3044\u3068\u601D\u3046\u3051\u3069\u306A\u3041\u300130\u4EE3\u304C\u3069\u3093\u304F\u3089\u3044\u304B\u306F\u308F\u304B\u3089\u306A\u3044\u3051\u3069\u5065\u5EB7\u7684\u3060\u3088\u306D\uFF01"
    background: {fileID: 0}
    nextLineId: prologue1_002
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue1_002
    speakerId: doute
    expressionId: normal
    text: "\u3055\u3066\u30B2\u30FC\u30E0\u306E\u7D9A\u304D\u3092\u2026\u2026\u3063\u3066\u3082\u3046\u3053\u3093\u306A\u6642\u9593\uFF01\uFF1F"
    background: {fileID: 0}
    nextLineId: prologue1_003
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue1_003
    speakerId: doute
    expressionId: normal
    text: "\u660E\u65E5\u306F\u4F11\u307F\u3068\u306F\u3044\u3048\u3001\u3046\u3063\u304B\u308A2\u6642\u307E\u3067\u8D77\u304D\u3061\u3083\u3063\u305F"
    background: {fileID: 0}
    nextLineId: prologue1_004
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue1_004
    speakerId: doute
    expressionId: normal
    text: "\u30B2\u30FC\u30E0\u3092\u30BB\u30FC\u30D6\u3057\u3066\u3063\u3068\u2026\u2026\u30E8\u30B7\uFF01\u30D2\u30ED\u30A4\u30F3\u306F\u307E\u305F\u660E\u65E5\u653B\u7565\u3057\u3088\u3046"
    background: {fileID: 0}
    nextLineId: prologue1_005
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue1_005
    speakerId: doute
    expressionId: normal
    text: "\u304F\u3042\u3041\u3041\u2026\u2026\u3055\u3059\u304C\u306B\u7720\u3044\u3084\u3001\u304A\u3084\u3059\u307F\u306A\u3055\u3044\u2026\u2026"
    background: {fileID: 0}
    nextLineId: 
    choices: []
    affectionChanges: []
    branches: []
