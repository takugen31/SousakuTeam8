    expressionId: normal
    text: "(\u305D\u306E\u5F8C3\u6642\u9593\u307B\u3069\u307F\u3063\u3061\u308A\u533B\u5B66\u66F8\u306E\u5185\u5BB9\u3092\u6559\u3048\u8FBC\u307E\u308C\u305F\u3002)"
