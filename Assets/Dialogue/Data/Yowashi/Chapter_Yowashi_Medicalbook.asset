  - lineId: chapter_yowashi_medicalbook_008
    speakerId: moteru
    expressionId: normal
    text: "\u3044\u3084\u307E\u3041\u305D\u308C\u306F\u2026\u2026\u61A7\u308C\u306E\u4EBA\u306B\u4F55\u304B\u3042\u3063\u305F\u3089\uFF7A\uFF9E\uFF86\uFF6E\uFF7A\uFF9E\uFF86\uFF6E\u2026\u2026"
    background: {fileID: 0}
