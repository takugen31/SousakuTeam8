    expressionId: normal
    text: "\u3093\uFF1F\u30E2\u30C6\u30EB\uFF01\uFF01\u3082\u3057\u304B\u3057\u3066\u30E2\u30C6\u30EB\u3063\u3066\u3053\u306E\u672C\u3063\u3066\u3069\u3093\u306A\u672C\u304B\u308F\u304B\u3063\u305F\u308A\u3057\u306A\u3044\uFF1F"
