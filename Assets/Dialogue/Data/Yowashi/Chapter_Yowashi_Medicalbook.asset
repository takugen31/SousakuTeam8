    speakerId: doute
    expressionId: normal
    text: "\uFF1F\r\n\u3000\u3088\u304F\u805E\u3053\u3048\u306A\u304B\u3063\u305F\u304B\u3089\u3082\u3046\u4E00\u5EA6\u884C\u3063\u3066\u304F\u308C\u306A\u3044\u304B\uFF1F"
