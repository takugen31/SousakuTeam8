  - lineId: chapter_yowashi_medicalbook_007
    speakerId: doute
    expressionId: normal
    text: "\u3044\u3084\u3054\u3081\u3093\u2026\u2026\u3053\u308C\u305D\u306E\u8FBA\u306B\u843D\u3061\u3066\u305F\u672C\u3089\u3057\u304F\u3066\u3055\u2026\u2026\r\n\u3000\u3063\u3066\u3044\u3046\u304B\u3001\u30E2\u30C6\u30EB\u306F\u3069\u3046\u3057\u3066\u305D\u3093\u306A\u3053\u3068\u77E5\u3063\u3066\u305F\u3093\u3060\uFF1F\u305D\u3046\u3044\u3046\u306E\u3063\u3066\u3042\u3093\u307E\u308A\u52C9\u5F37\u3059\u308B\u6A5F\u4F1A\u306A\u304F\u306A\u3044\uFF1F"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    fadeBeforeLine: 0
    lineFadeOutDuration: -1
    lineFadeHoldDuration: -1
    lineFadeInDuration: -1
