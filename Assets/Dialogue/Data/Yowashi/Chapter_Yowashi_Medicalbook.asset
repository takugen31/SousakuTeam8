  - lineId: chapter_yowashi_medicalbook_010
    speakerId: moteru
    expressionId: normal
    text: "\u3060\u3001\u5927\u4E08\u592B\uFF01\u5927\u3057\u305F\u3053\u3068\u3058\u3083\u306A\u3044\u304B\u3089\u2026\u2026\r\n\u3000\u305D\u308C\u3088\u308A\u3053\u306E\u672C\u306B\u66F8\u3044\u3066\u3042\u308B\u3053\u3068\u3001\u3056\u3063\u304F\u308A\u3067\u3044\u3044\u306A\u3089\u6559\u3048\u3088\u3046\u304B\uFF1F\u50D5\u304C\u308F\u304B\u308B\u3053\u3068\u3060\u3051\u3060\u3051\u3069\u2026\u2026"
