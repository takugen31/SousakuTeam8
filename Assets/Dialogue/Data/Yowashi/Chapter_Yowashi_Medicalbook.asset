  - lineId: chapter_yowashi_medicalbook_006
    speakerId: moteru
    expressionId: normal
    text: "\u3046\u3093\u3002\u3053\u306E\u3042\u305F\u308A\u3001\u5598\u606F\u306B\u3064\u3044\u3066\u66F8\u3044\u3066\u3042\u308B\u3088\u3002\u3053\u3093\u306A\u672C\u30C9\u30A6\u30C6\u304F\u3093\u306F\u6301\u3063\u3066\u305F\u3093\u3060\u306D\uFF01\u3084\u3063\u3071\u308A\u51C4\u3044\u3088\uFF01\uFF01"
