  - lineId: chapter_yowashi_medicalbook_004
    speakerId: moteru
    expressionId: normal
    text: "\u3053\u308C\u306F\u2026\u2026\u50D5\u3082\u305D\u3053\u307E\u3067\u3088\u304F\u5206\u304B\u3089\u306A\u3044\u3051\u3069\u3001\u533B\u5B66\u66F8\u3058\u3083\u306A\u3044\u304B\u306A\uFF1FSpO2\u3063\u3066\u3044\u3046\u306E\u306F\u805E\u3044\u305F\u3053\u3068\u3042\u308B\u3088\u3002\u78BA\u304B\u2026\u2026\u8840\u7BA1\u306E\u4E2D\u306E\u9178\u7D20\u6FC3\u5EA6\u3058\u3083\u306A\u304B\u3063\u305F\uFF1F"
