    text: "\u2026\u2026\u3053\u307B\u3093\uFF01\u3068\u308A\u3042\u3048\u305A\u72B6\u6CC1\u3092\u6574\u7406\u3059\u308B\u306E\u304C\u3044\u3044\u3088\u306A"
