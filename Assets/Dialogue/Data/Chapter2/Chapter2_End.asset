    text: "\u3046\u3093\u3001\u305D\u3046\u3057\u3088\u3046\u3002\u307E\u305A\u3001\u3053\u306E\u90E8\u5C4B\u306B\u306F\u51FA\u53E3\u304C\u306A\u3044\u3002\u3053\u308C\u306F\u7406\u89E3\u3057\u3066\u308B\u3088\u306D"
