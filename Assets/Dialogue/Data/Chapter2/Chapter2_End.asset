    text: "\u79C1\u306F\u53CD\u5BFE\u3002\u304D\u3063\u3068\u307B\u304B\u306E\u51FA\u53E3\u3082\u63A2\u305B\u3070\u3042\u308B\u3067\u3057\u3087\uFF1F\u305D\u308C\u306B\u308F\u305F\u3057\u3001\u3042\u3093\u305F\u305F\u3061\u307F\u305F\u3044\u306A\u3082\u3084\u3057\u3068\u604B\u611B\u306A\u3093\u3066\u305C\u30FC\u30FC\u30FC\u30FC\u30FC\u30FC\u3063\u305F\u3044\u306B\uFF01\u3044\u3084\u3060\u304B\u3089\u306D\uFF01"
