    text: "\u30E8\u30EF\u30B7\u3061\u3083\u3093\u3001\u305D\u306E\u5305\u5E2F\u3063\u3066\u3069\u3046\u3057\u305F\u306E\uFF1F\n\u306A\u3093\u304B\u3055\u3063\u304D\u51C4\u304F\u6016\u3044\u3082\u306E\u304C\u898B\u3048\u305F\u6C17\u304C\u3057\u305F\u3093\u3060\u3051\u3069\u2026\u2026"
