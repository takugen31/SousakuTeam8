  lines:
  - lineId: prologue_001
    speakerId: kayo
    expressionId: normal
    text: "\u300C\u4ECA\u65E5\u306F\u3042\u308A\u304C\u3068\u3046\u3001\u30C7\u30FC\u30C8\u697D\u3057\u304B\u3063\u305F\u308F\u300D"
    nextLineId: prologue_002
  - lineId: prologue_002
    speakerId: kayo
    expressionId: normal
    text: "\u300C\u3067\u3082\u3001\u98DF\u3079\u3059\u304E\u3066\u3061\u3087\u3063\u3068\u592A\u3063\u305F\u304B\u3082\u300D"
    nextLineId: prologue_003
  - lineId: prologue_003
    speakerId: doute
    expressionId: normal
    text: "\u300C\u4ECA\u4F55kg\u306A\u306E\uFF1F\u300D"
    background: {fileID: 5200507253851056871, guid: 15f1d0bba0218d44aaea51f98ac0d62c, type: 3}
    nextLineId: prologue_004
  - lineId: prologue_004
    speakerId: kayo
    expressionId: normal
    text: "\u300C\u3055\u3093\u3058\u3085......\u3063\u3066\u8A00\u3046\u308F\u3051\u306A\u3044\u3058\u3083\u306A\u3044\u3070\u304B\u3063\uFF01\u300D"
    nextLineId: prologue_005
  - lineId: prologue_005
    speakerId: kayo
    expressionId: normal
    text: "\u300C\u307E\u3063\u305F\u304F......\u305D\u3053\u305D\u3053\u697D\u3057\u304B\u3063\u305F\u308F\u3001\u307E\u305F\u306D\u300D"
