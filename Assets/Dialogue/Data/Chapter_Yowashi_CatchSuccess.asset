  - lineId: chapter_yowashi_catchsuccess_002
    speakerId: yowashi
    expressionId: normal
    text: "よく……やったぞ……ドウテ卿！！"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_003
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_003
    speakerId: doute
    expressionId: normal
    text: "光栄です、ヨワシ様"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_004
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_004
    speakerId: yowashi
    expressionId: normal
    text: "この……試練に……合格した……証として……この本を……やろう"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_005
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_005
    speakerId: doute
    expressionId: normal
    text: "こ、この本は！？"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_006
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_006
    speakerId: yowashi
    expressionId: normal
    text: "実は……ここに……たまたま……落ちてた……だけだから……私も……読んだこと……なくて……何の本かすら……知らない……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_007
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_007
    speakerId: doute
    expressionId: normal
    text: "えぇ……\n　まあヨワシちゃんからのプレゼントだからこそ、ありがたくもらうよ！ありがとう！"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_008
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_008
    speakerId: 
    expressionId: 
    text: "［何かの本］を手に入れた！"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_009
    choices: []
    affectionChanges: []
    archiveUnlockIds:
    - chapter_yowashi.unknown_book
    branches: []
  - lineId: chapter_yowashi_catchsuccess_009
    speakerId: yowashi
    expressionId: normal
    text: "うむ……苦しゅう……ない……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_010
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_010
    speakerId: doute
    expressionId: normal
    text: "いや苦しゅうないは嘘じゃない？めっちゃ苦しそうだけど……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_011
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_011
    speakerId: yowashi
    expressionId: normal
    text: "仕方ない……ひとまず……今日はこれで……撤退しよう……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_012
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_012
    speakerId: doute
    expressionId: normal
    text: "ゆっくり休んでね、ヨワシちゃん"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_013
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_013
    speakerId: doute
    expressionId: normal
    text: "(おかしいな、キャッチボールって言っても2分くらいしかやってないと思うんだけど……あんなに息切れするもんかな？)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_014
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_catchsuccess_014
    speakerId: 
    expressionId: 
    text: "［情報］ヨワシは息切れしやすい　を手に入れた"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_catchsuccess_015
    choices: []
    affectionChanges: []
    archiveUnlockIds:
    - chapter_yowashi.breathlessness
    branches: []
  - lineId: chapter_yowashi_catchsuccess_015
    speakerId: doute
    expressionId: normal
    text: "ヨワシちゃんからもらった本、せっかくなら見てみようかな"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: 
