  - lineId: prologue_002
    speakerId: kayo
    expressionId: normal
    text: "「でも、食べすぎてちょっと太ったかも...」"
    nextLineId: prologue_003
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue_003
    speakerId: doute
    expressionId: normal
    text: "「今何kgなの？」"
