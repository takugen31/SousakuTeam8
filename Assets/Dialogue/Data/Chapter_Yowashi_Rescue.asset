    branches: []
  - lineId: chapter_yowashi_rescue_020
    speakerId: yowashi
    expressionId: normal
    text: "信じてたよ、ドウテくん"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_021
    choices: []
    affectionChanges: []
