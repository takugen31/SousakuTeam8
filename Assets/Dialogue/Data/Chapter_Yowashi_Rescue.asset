  lines:
  - lineId: chapter_yowashi_rescue_001
    speakerId: moteru
    expressionId: normal
    text: "ドウテくん！僕はカヨちゃんを本棚の下から助けるから、ヨワシちゃんの手当をしてあげて！"
    background: {fileID: -990163987816521801, guid: 2f638f3b99bcade49888e208c0066080, type: 3}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_002
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_002
    speakerId: doute
    expressionId: normal
    text: "わかった！モテル、ありがとな"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_003
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_003
    speakerId: moteru
    expressionId: normal
    text: "こちらこそだよ、ありがとう、ドウテくん！"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_004
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_004
    speakerId: doute
    expressionId: normal
    text: "(モテルならきっと大丈夫だ。俺はヨワシちゃんを助けてあげないと……！)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_005
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_005
    speakerId: doute
    expressionId: normal
    text: "(確かまずは意識の確認……)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_006
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_006
    speakerId: doute
    expressionId: normal
    text: "ヨワシちゃん聞こえる？聞こえたら何でもいいから合図して！！"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_007
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_007
    speakerId: yowashi
    expressionId: normal
    text: "……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_008
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_008
    speakerId: doute
    expressionId: normal
    text: "(意識はなさそうだ……次は心拍と呼吸の確認だけど……)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_009
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_009
    speakerId: yowashi
    expressionId: normal
    text: "…"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_010
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_010
    speakerId: doute
    expressionId: normal
    text: "(明らかに呼吸数が減ってきてる。心拍は……ない)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_011
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_011
    speakerId: doute
    expressionId: normal
    text: "(やばいやばいやばい！！\n　一度深呼吸しよう。そうだ、そういえばあのヨワシちゃんの言葉……)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_012
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_012
    speakerId: yowashi
    expressionId: normal
    text: "何よりドウテくんもいるしね〜"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_013
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_013
    speakerId: doute
    expressionId: normal
    text: "(そうだ、ヨワシちゃんはきっと俺なら助けてくれると信じてたんだ。それにヨワシちゃんがくれた医学書も、そんなに都合よく喘息の本が落ちてると思えないし……\n　きっともし自分に何かあった時に助けてくれると信じて、俺に医学書を渡してくれたんじゃないか？)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_014
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_014
    speakerId: doute
    expressionId: normal
    text: "ヨワシちゃんは俺が必ず助ける！"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: 
    choices:
    - text: "成功"
      nextLineId: chapter_yowashi_rescue_015
    - text: "失敗"
      nextLineId: chapter_yowashi_rescue_039
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_015
    speakerId: doute
    expressionId: normal
    text: "ヨワシちゃん聞こえる？大丈夫？"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
