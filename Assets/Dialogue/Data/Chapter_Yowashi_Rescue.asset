    branches: []
  - lineId: chapter_yowashi_rescue_021
    speakerId: moteru
    expressionId: normal
    text: "ドウテくん！ヨワシさん！大丈夫？"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_022
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_022
    speakerId: doute
    expressionId: normal
    text: "モテル！そっちこそ大丈夫か？"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_023
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_023
    speakerId: moteru
    expressionId: normal
    text: "うん、なんとか大丈夫だったよ。ただ、部屋がひび割れてきてる。カヨさんも歩けるそうだから、一緒に逃げよう"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_024
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_024
    speakerId: doute
    expressionId: normal
    text: "おう！\n　ヨワシちゃん、立てそう……？"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_025
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_025
    speakerId: yowashi
    expressionId: normal
    text: "むりだから……おんぶして……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_026
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_026
    speakerId: doute
    expressionId: normal
    text: "！！\n　が、頑張ります！"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_027
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_027
    speakerId: doute
    expressionId: normal
    text: "(初めて背負った女の子は、とてもとても軽かった。)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_028
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_028
    speakerId: yowashi
    expressionId: normal
    text: "ドウテくん……背中に乗ってる私が……いうのはあれなんだけど……これってなんだか……漫画のワンシーン……みたいじゃない？"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_029
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_029
    speakerId: doute
    expressionId: normal
    text: "確かに。漫画だとこのあと……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_030
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_030
    speakerId: doute
    expressionId: normal
    text: "(はっ。このあと告白する流れでは？いやでも流石に会ったばっかりだし……)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_031
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_031
    speakerId: yowashi
    expressionId: normal
    text: "このあとなーに？私、期待しちゃうかも〜"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_032
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_032
    speakerId: doute
    expressionId: normal
    text: "うぐっ。そういうの俺初めてだから……ちゃんとしたのはまた今度しようと思ってたんだけど……"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_033
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_033
    speakerId: yowashi
    expressionId: normal
    text: "いいのいいの、こういうのはなんぼ言ってもいいんですから〜"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_034
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_034
    speakerId: doute
    expressionId: normal
    text: "わかったよ"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_rescue_035
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_rescue_035
    speakerId: doute
    expressionId: normal
    text: "ヨワシちゃん。俺はあなたのことが好きです。付き合ってください！"
