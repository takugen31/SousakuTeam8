  lines:
  - lineId: prologue2_001
    speakerId: doute
    expressionId: normal
    text: "\u3093\u3093\u2026\u2026\u306F\u3063\uFF01\u4ECA\u4F55\u6642\u2026\u2026\u3063\u3066\u3001\u3069\u3053\u3060\u3053\u3053\uFF01"
    background: {fileID: -990163987816521801, guid: 2f638f3b99bcade49888e208c0066080, type: 3}
    nextLineId: prologue2_002
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_002
    speakerId: doute
    expressionId: normal
    text: "\u2026\u2026\u2026\u2026\uFF01\u3053\u307B\u3093\u3063"
    background: {fileID: 0}
    nextLineId: prologue2_003
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_003
    speakerId: doute
    expressionId: normal
    text: "\u77E5\u3089\u306A\u3044\u5929\u4E95\u3060\u2026\u2026"
    background: {fileID: 0}
    nextLineId: 
    choices:
    - text: "\u30F2\u30BF\u30AF\u3059\u304E\u308B\u3060\u308D\u2026\u2026"
      nextLineId: prologue2_004
    - text: "\u8A18\u5FF5\u3059\u3079\u304D\u521D\u9078\u629E\u80A2\u3053\u3053\u3067\u4F7F\u3046\u306E\uFF1F"
      nextLineId: prologue2_004
    - text: "\u30CE\u30FC\u30B3\u30E1\u30F3\u30C8\u3060\u3088"
      nextLineId: prologue2_004
    - text: "\u30A8\u3007\u30D1\u30ED\u3067\u3059\u3088\uFF01\u898B\u3066\u304F\u3060\u3055\u3044\uFF01"
      nextLineId: prologue2_004
    affectionChanges: []
    branches: []
  - lineId: prologue2_004
    speakerId: doute
    expressionId: normal
    text: "\u3046\u308F\u3063\u4F55\u3053\u306E\u58F0\u3063\uFF01\u8133\u5185\u306B\u76F4\u63A5\u2026\u2026\uFF01"
    background: {fileID: 0}
    nextLineId: 
    choices:
    - text: "\u30F2\u30BF\u30AF\u3059\u304E\u308B\u3060\u308D\u2026\u2026"
      nextLineId: prologue2_005
    - text: "\u2026\u2026"
      nextLineId: prologue2_005
    - text: "\u30CE\u30FC\u30B3\u30E1\u30F3\u30C8\u661F\u4EBA\u3060\u3088"
      nextLineId: prologue2_005
    - text: "\u306A\u3093\u304B\u3048\u3063\u3061\u3058\u3083\u306A\u3044\uFF1F"
      nextLineId: prologue2_005
    affectionChanges: []
    branches: []
  - lineId: prologue2_005
    speakerId: doute
    expressionId: normal
    text: "\u307E\u305F\u3060\u2026\u2026\u660E\u3089\u304B\u306B\u306A\u306B\u304B\u3044\u308B\uFF01\u307E\u3055\u304B\u8A98\u62D0\u72AF\u2026\u2026\uFF1F"
    background: {fileID: 0}
    nextLineId: 
    choices:
    - text: "\u9055\u3046\u3088"
      nextLineId: prologue2_006
    affectionChanges: []
    branches: []
  - lineId: prologue2_006
    speakerId: doute
    expressionId: normal
    text: "\u3042\u3063\u9055\u3046\u3093\u3060\u2026\u2026\u3068\u3044\u3046\u3088\u308A\u610F\u601D\u758E\u901A\u304C\u6210\u529F\u3057\u305F\uFF1F\uFF01"
    background: {fileID: 0}
    nextLineId: prologue2_007
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_007
    speakerId: doute
    expressionId: normal
    text: "\u3053\u306E\u90E8\u5C4B\u3068\u3044\u3044\u3053\u306E\u58F0\u3068\u3044\u3044\u306A\u3093\u306A\u3093\u3060\u2026\u2026"
    background: {fileID: 0}
    nextLineId: prologue2_008
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_008
    speakerId: doute
    expressionId: normal
    text: "\u3048\u3063\u3068\u3001\u3072\u3068\u307E\u305A\u5929\u306E\u58F0\u2026\u2026\u306F\u8A00\u3044\u305A\u3089\u3044\u306A"
    background: {fileID: 0}
    nextLineId: prologue2_009
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_009
    speakerId: doute
    expressionId: normal
    text: "\u3046\u30FC\u3093\u2026\u2026"
    background: {fileID: 0}
    nextLineId: prologue2_010
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_010
    speakerId: doute
    expressionId: normal
    text: "\u30D7\u30EC\u30A4\u30E4\u30FC\u3055\u3093"
    background: {fileID: 0}
    nextLineId: prologue2_011
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_011
    speakerId: doute
    expressionId: normal
    text: "\u3053\u306E\u90E8\u5C4B\u304C\u306A\u306B\u304B\u5206\u304B\u308A\u307E\u3059\u304B\uFF1F\u2026\u2026\u3063\u3066\u3072\u3068\u308A\u3067\u4F55\u3084\u3063\u3066\u3093\u3060\u4FFA\u306F"
    background: {fileID: 0}
    nextLineId: 
    choices:
    - text: "\u77E5\u3089\u3093\u304C\u306A"
      nextLineId: prologue2_question_a
    - text: "\u767D\u3044\u90E8\u5C4B\u3060\u306D"
      nextLineId: prologue2_question_b
    - text: "\u5B9F\u306F\u81EA\u5206\u3053\u305D\u9ED2\u5E55\u2026\u2026"
      nextLineId: prologue2_question_c
    - text: "\u3048\u3063\u3061\u306A\u90E8\u5C4B\u3060\u306D"
      nextLineId: prologue2_question_d
    affectionChanges: []
    branches: []
  - lineId: prologue2_question_a
    speakerId: doute
    expressionId: normal
    text: "\u6295\u3052\u3084\u308A\u3059\u304E\u308B\u2026\u2026\uFF01"
    background: {fileID: 0}
    nextLineId: prologue2_012
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_question_b
    speakerId: doute
    expressionId: normal
    text: "\u3048\u3063\u3068\u3001\u305D\u306E\u901A\u308A\u3067\u306F\u3042\u308B\u3093\u3060\u3051\u3069\u2026\u2026\u305D\u3046\u3058\u3083\u306D\u3048\uFF01"
    background: {fileID: 0}
    nextLineId: prologue2_012
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_question_c
    speakerId: doute
    expressionId: normal
    text: "\u8FD1\u5E74\u306E\u30BD\u30B7\u30E3\u30B2\u4E3B\u4EBA\u516C\u304F\u3089\u3044\u81EA\u7531\u3060\u306A\u3053\u306E\u4EBA\u2026\u2026"
    background: {fileID: 0}
    nextLineId: prologue2_012
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_question_d
    speakerId: doute
    expressionId: normal
    text: "\u982D\u3092\u3088\u304E\u3063\u305F\u3053\u3068\u306F\u5426\u5B9A\u3057\u306A\u3044\u3051\u3069\u8A00\u8449\u5F37\u304F\u306A\u3044\u304B\uFF1F\uFF01"
    background: {fileID: 0}
    nextLineId: prologue2_012
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_012
    speakerId: doute
    expressionId: normal
    text: "\u3068\u308A\u3042\u3048\u305A\uFF01"
    background: {fileID: 0}
    nextLineId: prologue2_013
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_013
    speakerId: doute
    expressionId: normal
    text: "\u4FFA\u306E\u8A00\u8449\u304C\u805E\u3053\u3048\u3066\u308B\u5354\u529B\u7684\u2026\u2026\u304B\u306F\u5206\u304B\u3089\u306A\u3044\u3051\u3069\u3001\u4F55\u8005\u304B\u304C\u3044\u308B\uFF01"
    background: {fileID: 0}
    nextLineId: prologue2_014
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_014
    speakerId: doute
    expressionId: normal
    text: "\u4FFA\u306F\u84EE\u611B\u30C9\u30A6\u30C6\u3067\u3059\uFF01\u304A\u9858\u3044\u3067\u3059\uFF01\u5354\u529B\u3057\u3066\u304F\u3060\u3055\u3044\uFF01"
    background: {fileID: 0}
    revealSpeakerName: 1
    nextLineId: prologue2_015
    choices: []
    affectionChanges: []
    branches: []
  - lineId: prologue2_015
    speakerId: doute
    expressionId: normal
    text: "\u8A98\u62D0\u3060\u308D\u3046\u304C\u6109\u5FEB\u72AF\u3060\u308D\u3046\u304C\u3053\u3063\u3061\u306B\u3068\u3063\u3066\u306F\u6709\u5BB3\u306A\u3093\u3067\u3059\u3088\uFF01"
