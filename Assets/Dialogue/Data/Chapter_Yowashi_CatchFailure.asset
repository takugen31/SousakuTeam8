  defaultBackground: {fileID: 0}
  lines:
  - lineId: chapter_yowashi_catchfailure_001
    speakerId: doute
    expressionId: normal
    text: "(何か変なものまで飛んできてなかった……？)"
    background: {fileID: -990163987816521801, guid: 2f638f3b99bcade49888e208c0066080, type: 3}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
