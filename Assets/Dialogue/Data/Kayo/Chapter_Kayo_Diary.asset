  defaultBackground: {fileID: -990163987816521801, guid: 2f638f3b99bcade49888e208c0066080, type: 3}
  lines:
  - lineId: chapter_kayo_diary_001
    speakerId: doute
    expressionId: normal
    text: "よし！組み立て成功！手がかりかもしれないし、内容を見てみよう……！"
    background: {fileID: 0}
    revealSpeakerName: 1
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_002
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_002
    speakerId: 
    expressionId: 
    text: "『20XX年月日』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_003
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_003
    speakerId: 
    expressionId: 
    text: "『きょうも完ぺき！テストも100点まん点！ままとぱぱとねぇねにたくさんほめられた！これからもがんばる！』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_004
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_004
    speakerId: 
    expressionId: 
    text: "『20XX年月日』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_005
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_005
    speakerId: 
    expressionId: 
    text: "『最近、ママはぐあいが悪いみたい。ママもパパもお姉ちゃんもすぐ良くなるって言うけど心配だなぁ……そうだ！わたしががんばってテストもおうちのお手伝いもしたらきっとすぐ元気になるよね！』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_006
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_006
    speakerId: 
    expressionId: 
    text: "『20XX年月日』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_007
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_007
    speakerId: 
    expressionId: 
    text: "『ママとパパは今日も褒めてくれた、嬉れしい！これくらい当然だもの！けど、前はしなかったようなミスが増えちゃった、きっと努力が足りてない証拠よね……！もっと、頑張らないと……』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_008
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_008
    speakerId: 
    expressionId: 
    text: "『20XX年6月15日』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_009
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_009
    speakerId: 
    expressionId: 
    text: "『お母さんが亡くなった。わたしのせいだ……！わたしがミスをしつずけてお母さんに芯配をかけさせたから、病気が悪くなっちゃったんだ……っ！お母さんがいない分もわたしがもっと、もっとがんばらなきゃ……！』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_010
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_010
    speakerId: 
    expressionId: 
    text: "『20XX年6月15日』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_011
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_011
    speakerId: 
    expressionId: 
    text: "『また、ドジをしてしまった……。子供の頃はこんなにドジをしなかったのに。先生の手伝いで本を運んでいたら転んでしまって危うく友達にケガをさせるところだった。幸運なことにケガはしてなかったらしいけど、本がその子の足に落ちて痛い思いをさせちゃった。明日、ちゃんと謝らないと。』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_012
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_012
    speakerId: 
    expressionId: 
    text: "『20XX年6月19日』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_013
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_013
    speakerId: 
    expressionId: 
    text: "『ごめんなさい、わたしのせいだ。友達が広めたうそのうわさのせいでお父さんが学校に呼び出されちゃった。お父さんはわたしが暴力を振るうわけないってわかってくれてるけど、忙しいのに迷惑かけちゃった。先生との面談で片親だから仕方ないって言われた。悔しい……！悔しかったけど、何もできないんだ……。』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_014
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_014
    speakerId: 
    expressionId: 
    text: "『20XX年6月30日』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: chapter_kayo_diary_015
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_kayo_diary_015
    speakerId: 
    expressionId: 
    text: "『誰にも、あんなこと言わせないって頑張ったのに……ダメだった。お姉ちゃんもお父さんも無理しなくていいって言ってくれたけど、結果が出なきゃ努力なんて無意味じゃない……！悔しくて涙が出るとそれを2人が慰めてくれて、また悔しくて涙が出た。ドジのままでいいわけなんてない！』"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle: 
    nextScenePath: 
    nextLineId: 
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
