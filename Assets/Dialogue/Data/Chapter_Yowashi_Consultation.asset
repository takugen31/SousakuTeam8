  - lineId: chapter_yowashi_consultation_001
    speakerId: 
    expressionId: 
    text: "一回状況を整理しよう"
    background: {fileID: -990163987816521801, guid: 2f638f3b99bcade49888e208c0066080, type: 3}
    revealSpeakerName: 0
