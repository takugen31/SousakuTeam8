  - lineId: chapter_yowashi_diary_013
    speakerId: 
    expressionId: 
    text: "大丈夫、私は明るい子、強い子、大丈夫"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_diary_014
    choices: []
