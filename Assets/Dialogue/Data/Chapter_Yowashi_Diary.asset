    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_diary_014
    speakerId: 
    expressionId: 
    text: "(これ以降、同じ言葉が時々書かれているだけだ)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_diary_015
    choices: []
    affectionChanges: []
    archiveUnlockIds: []
    branches: []
  - lineId: chapter_yowashi_diary_015
    speakerId: doute
    expressionId: normal
    text: "(これは……誰かの日記？まさかヨワシちゃん……？いやまさかね。あんなに明るい子なのにそんなことないよね！一応ヨワシちゃんに確認してみよう)"
    background: {fileID: 0}
    revealSpeakerName: 0
    consultationTitle:
    nextScenePath: 
    nextLineId: chapter_yowashi_diary_016
